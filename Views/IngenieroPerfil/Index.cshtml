@model IngeLab.Models.IngenieroPerfilViewModel
@{
    Layout = null;
    ViewData["Title"] = $"{Model.Perfil_Ingeniero.Nombre} {Model.Perfil_Ingeniero.Apellido}";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - IngeLab</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet" href="~/css/Perfil.css" asp-append-version="true">
</head>
<body class="body-perfil">

    <div class="perfil-container">

        <main class="perfil-grid">

            <header class="perfil-header">
                <div class="perfil-banner">
                    <img src="~/images/AI_Generated_Banner_One.png" alt="Banner del perfil">
                </div>
                <div class="perfil-info-bar">
                    <div class="perfil-avatar">
                        <img src="https://via.placeholder.com/150" alt="Foto de perfil">
                    </div>
                    <div class="perfil-nombre">
                        <h1>@Model.Perfil_Ingeniero.Nombre @Model.Perfil_Ingeniero.Apellido</h1>
                        <p>@(string.IsNullOrEmpty(Model.Perfil_Ingeniero.Especializacion) ? "Especialización no definida" : Model.Perfil_Ingeniero.Especializacion)</p>
                        <p class="perfil-contratado-por">@(string.IsNullOrEmpty(Model.Perfil_Ingeniero.ContratadoPor) ? "No contratado" : "Contratado por: " + Model.Perfil_Ingeniero.ContratadoPor)</p>
                    </div>
                    <div class="perfil-acciones">
                        @if (Model.IsOwnProfile)
                        {
                            <button type="button" class="btn-editar-perfil" onclick="mostrarFormularioEdicion()">
                                <i class="fas fa-pen"></i> Editar Perfil
                            </button>
                        }

                        <a href="@Url.Action("Index", "Logout")" class="btn-logout">
                            <i class="fas fa-sign-out-alt"></i> Cerrar Cesión
                        </a>
                    </div>
                </div>
            </header>

            <aside class="columna-info">
                <div class="panel-card-perfil">
                    <h3 class="panel-titulo">Información Profesional</h3>
                    @if (Model.Perfil_Ingeniero.Anios_Experiencia > 0)
                    {
                        <p><strong>Experiencia:</strong> @Model.Perfil_Ingeniero.Anios_Experiencia años</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Perfil_Ingeniero.Nivel_Academico))
                    {
                        <p><strong>Nivel Académico:</strong> @Model.Perfil_Ingeniero.Nivel_Academico</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Perfil_Ingeniero.Disponibilidad))
                    {
                        <p><strong>Disponibilidad:</strong> @Model.Perfil_Ingeniero.Disponibilidad</p>
                    }

                    @if (Model.Perfil_Ingeniero.Anios_Experiencia == 0 && string.IsNullOrEmpty(Model.Perfil_Ingeniero.Nivel_Academico))
                    {
                        <p>Completa tu perfil profesional para mostrar más información.</p>
                        <a href="@Url.Action("Index", "IngCompletarPerfil")" class="btn btn-primary">Completar Perfil</a>
                    }
                </div>

                @if (Model.Lista_Habilidades != null && Model.Lista_Habilidades.Any())
                {
                    <div class="panel-card-perfil">
                        <h3 class="panel-titulo">Habilidades Técnicas</h3>
                        <div class="tags-container-perfil">
                            @foreach (var skill in Model.Lista_Habilidades)
                            {
                                <span class="skill-tag-perfil">@skill</span>
                            }
                        </div>
                    </div>
                }

                @if (Model.Idiomas != null && Model.Idiomas.Any())
                {
                    <div class="panel-card-perfil">
                        <h3 class="panel-titulo">Idiomas</h3>
                        <div class="tags-container-perfil">
                            @foreach (var skill in Model.Idiomas)
                            {
                                <span class="skill-tag-perfil">@skill</span>
                            }
                        </div>
                    </div>
                }
            </aside>

            <section class="columna-contenido">

                <div id="perfil-view" class="panel-card-perfil">
                    <h3 class="panel-titulo">Datos Personales</h3>
                    <div class="grid-formulario">
                        <div class="campo-individual">
                            <label for="nombre" class="label-estilizado">Nombre</label>
                            <input type="text" id="nombre" class="input-estilizado" value="@Model.Perfil_Ingeniero.Nombre" readonly />
                        </div>

                        <div class="campo-individual">
                            <label for="apellidos" class="label-estilizado">Apellidos</label>
                            <input type="text" id="apellidos" class="input-estilizado" value="@Model.Perfil_Ingeniero.Apellido" readonly />
                        </div>

                        <div class="campo-individual">
                            <label for="nombre" class="label-estilizado">Numero De Documento</label>
                            <input type="text" id="NumeroDocumento" class="input-estilizado" value="@Model.Perfil_Ingeniero.NumeroDocumento" readonly />
                        </div>

                        <div class="campo-individual">
                            <label for="correo" class="label-estilizado">Correo</label>
                            <input type="email" id="correo" class="input-estilizado" value="@Model.Perfil_Ingeniero.Correo" readonly />
                        </div>

                        <div class="campo-individual">
                            <label for="telefono" class="label-estilizado">Teléfono</label>
                            <input type="text" id="telefono" class="input-estilizado" value="@Model.Perfil_Ingeniero.Telefono" readonly />
                        </div>

                    </div>
                </div>

                <div id="perfil-edit" class="panel-card-perfil" style="display:none;">
                    <h3 class="panel-titulo">Editar Datos Personales</h3>
                    <form asp-controller="IngenieroPerfil" asp-action="Editar" method="post">
                        <input type="hidden" name="IdUsuario" value="@Model.Perfil_Ingeniero.Id_Usuario" />

                        <div class="grid-formulario">
                            <div class="campo-individual">
                                <label for="nombre-edit" class="label-estilizado">Nombre</label>
                                <input type="text" id="nombre-edit" name="Nombre" class="input-estilizado" value="@Model.Perfil_Ingeniero.Nombre" />
                            </div>
                            <div class="campo-individual">
                                <label for="apellidos-edit" class="label-estilizado">Apellidos</label>
                                <input type="text" id="apellidos-edit" name="Apellido" class="input-estilizado" value="@Model.Perfil_Ingeniero.Apellido" />
                            </div>
                            <div class="campo-individual">
                                <label for="apellidos-edit" class="label-estilizado">Numero De Documento</label>
                                <input type="text" id="NumeroDocumento-edit" name="NumeroDocumento" class="input-estilizado" value="@Model.Perfil_Ingeniero.NumeroDocumento" />
                            </div>
                            <div class="campo-individual">
                                <label for="correo-edit" class="label-estilizado">Correo</label>
                                <input type="email" id="correo-edit" name="Correo" class="input-estilizado" value="@Model.Perfil_Ingeniero.Correo" />
                            </div>
                            <div class="campo-individual">
                                <label for="telefono-edit" class="label-estilizado">Teléfono</label>
                                <input type="text" id="telefono-edit" name="Telefono" class="input-estilizado" value="@Model.Perfil_Ingeniero.Telefono" />
                            </div>

                            <div class="campo-individual">
                                <label for="Anios_Experiencia" class="label-estilizado">Años de Experiencia</label>
                                <input type="text" name="Anios_Experiencia" id="Anios_Experiencia" class="input-estilizado" value="@Model.Perfil_Ingeniero.Anios_Experiencia" />
                            </div>

                            <div class="campo-individual">
                                <label for="Nivel_Academico" class="label-estilizado">Nivel Academico</label>
                                <select id="Nivel_Academico" name="Nivel_Academico" class="input-estilizado" value="@Model.Perfil_Ingeniero.Nivel_Academico">
                                    <option value="" disabled selected>Tu máximo nivel de estudios</option>
                                    <option value="bachillerato" selected="@(Model.Perfil_Ingeniero.Nivel_Academico == "bachillerato")">Bachillerato</option>
                                    <option value="certificaciones" selected="@(Model.Perfil_Ingeniero.Nivel_Academico == "certificaciones")">Certificaciones</option>
                                    <option value="licenciatura" selected="@(Model.Perfil_Ingeniero.Nivel_Academico == "licenciatura")">Licenciatura / Pregrado</option>
                                    <option value="maestria" selected="@(Model.Perfil_Ingeniero.Nivel_Academico == "maestria")">Maestría / Postgrado</option>
                                    <option value="doctorado" selected="@(Model.Perfil_Ingeniero.Nivel_Academico == "doctorado")">Doctorado</option>
                                </select>
                            </div>

                            <div class="campo-individual campo-full">
                                <label for="disponibilidad" class="label-estilizado">Disponibilidad</label>
                                <select id="Disponibilidad" name="Disponibilidad" class="input-estilizado" value="@Model.Perfil_Ingeniero.Disponibilidad">
                                    <option value="" disabled selected>Define tu disponibilidad</option>
                                    <option value="full-time" selected="@(Model.Perfil_Ingeniero.Disponibilidad == "full-time")">Jornada Completa</option>
                                    <option value="part-time" selected="@(Model.Perfil_Ingeniero.Disponibilidad == "part-time")">Media Jornada</option>
                                    <option value="freelance" selected="@(Model.Perfil_Ingeniero.Disponibilidad == "freelance")">Freelance / Por Proyecto</option>
                                    <option value="open" selected="@(Model.Perfil_Ingeniero.Disponibilidad == "open")">Abierto a Ofertas</option>
                                </select>
                            </div>


                            <div class="campo-full">
                                <label for="habilidades" class="label-estilizado">Habilidades Técnicas</label>
                                <textarea id="Habilidades_Tecnicas" name="Habilidades_Tecnicas" class="input-estilizado" rows="3" placeholder="Ej: C#, .NET, Azure, SQL, Metodologías Ágiles..."> @(Model.Perfil_Ingeniero.Habilidades_Tecnicas)</textarea>
                            </div>


                            <div class="campo-full">
                                <label for="idiomas" class="label-estilizado">Idiomas</label>
                                <textarea id="Idiomas" name="Idiomas" class="input-estilizado" rows="2" placeholder="Ej: Español (Nativo), Inglés (C1)..."> @(Model.Perfil_Ingeniero.Idiomas)</textarea>
                            </div>



                        </div>

                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-secondary" onclick="cancelarEdicion()">Cancelar</button>
                        @{
                            var idUsuario = Context.Session.GetInt32("UsuarioId") ?? 0;
                        }
                        <input type="hidden" name="Id_Usuario" value="@idUsuario" />
                    </form>
                </div>
                <div class="panel-card-perfil" style="margin-top: 30px;">
                    <h3 class="panel-titulo">Publicaciones</h3>
                    @if (Model.Posts != null && Model.Posts.Any())
                    {
                        // Usamos la clase .post-card que ya estilizamos
                        @foreach (var post in Model.Posts)
                        {
                            <div class="post-card">
                                <div class="post-header">
                                    <img src="https://via.placeholder.com/45" alt="autor" class="post-autor-foto">
                                    <div class="post-autor-info">
                                        <h4>@Model.Perfil_Ingeniero.Nombre @Model.Perfil_Ingeniero.Apellido</h4>
                                        <p>@post.FechaCreacion.ToString("dd MMM, HH:mm")</p>
                                    </div>

                                    @if (Model.IsOwnProfile)
                                    {
                                        <div class="post-opciones">
                                            <button type="button" class="btn-opciones" onclick="toggleMenu(this)">
                                                <i class="fas fa-ellipsis-h"></i>
                                            </button>
                                            <div class="opciones-menu">
                                                <a href="javascript:void(0);" class="opcion-editar" onclick="editarPost(@post.Id_Post)">Editar Publicación</a>
                                                <a href="javascript:void(0);" class="opcion-fijar" onclick="fijarPost(@post.Id_Post, @(post.Fijado ? "false" : "true"))">
                                                    @(post.Fijado ? "Desfijar" : "Fijar") Publicación
                                                </a>
                                                <form asp-action="EliminarPost" asp-controller="VistaIngenieros" method="post" style="display:inline;">
                                                    <input type="hidden" name="idPost" value="@post.Id_Post" />
                                                    <a href="javascript:void(0);" class="opcion-eliminar" onclick="this.closest('form').submit(); return false;">Eliminar</a>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="post-contenido" id="post-contenido-@post.Id_Post">
                                    @if (post.Tipo_Contenido == "texto")
                                    {
                                        <p>@post.Contenido</p>
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(post.TextoExplicativo))
                                        {
                                            <p>@post.TextoExplicativo</p>
                                        }
                                        <div class="code-block-container">
                                            <div class="code-block-header">
                                                <span class="language-tag">@post.Tipo_Contenido</span>
                                                <button type="button" class="copy-code-btn" onclick="copiarCodigo(this)">
                                                    <i class="far fa-copy"></i> Copiar
                                                </button>
                                            </div>
                                            <pre><code class="language-@post.Tipo_Contenido">@Html.Raw(post.Codigo)</code></pre>
                                        </div>
                                    }
                                </div>

                                @if (Model.IsOwnProfile)
                                {
                                    <div class="post-contenido" id="form-editar-@post.Id_Post" style="display:none;">
                                        <form method="post" asp-controller="VistaIngenieros" asp-action="EditarPost">
                                            <input type="hidden" name="idPost" value="@post.Id_Post" />
                                            <textarea name="contenido" class="form-control" style="width:100%">@post.Contenido</textarea>
                                            <div class="mt-2" style="display: flex; justify-content: flex-end; gap: 10px; margin-top:10px;">
                                                <button type="submit" class="btn btn-success btn-sm">Guardar</button>
                                                <button type="button" class="btn btn-secondary btn-sm" onclick="cancelarEdicion(@post.Id_Post)">Cancelar</button>
                                            </div>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p>No hay publicaciones aún</p>
                    }
                </div>
            </section>
        </main>
    </div>

    <div style="position: fixed; top: 20px; left: 20px;">
        <a href="/VistaIngenieros/Index" class="btn-volver">
            <i class="fas fa-arrow-left"></i> Volver al Dashboard
        </a>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <script>
        // Se inicializa PrismJS al cargar la página
        document.addEventListener('DOMContentLoaded', () => {
            Prism.highlightAll();
        });

        // Scripts para el menú, edición, fijado y copiado de posts
        function toggleMenu(button) {
            const menu = button.nextElementSibling;
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
        function editarPost(idPost) {
            document.getElementById("post-contenido-" + idPost).style.display = "none";
        document.getElementById("form-editar-" + idPost).style.display = "block";
        }
        function cancelarEdicion(idPost) {
            document.getElementById("form-editar-" + idPost).style.display = "none";
        document.getElementById("post-contenido-" + idPost).style.display = "block";
        }
        function fijarPost(idPost, fijar) {
            // Crear formulario dinámicamente
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/VistaIngenieros/FijarPost';

            // Input para idPost
            const inputId = document.createElement('input');
            inputId.type = 'hidden';
            inputId.name = 'idPost';
            inputId.value = idPost;

            // Input para fijar
            const inputFijar = document.createElement('input');
            inputFijar.type = 'hidden';
            inputFijar.name = 'fijar';
            inputFijar.value = fijar;

            // Agregar inputs al formulario y enviarlo
            form.appendChild(inputId);
            form.appendChild(inputFijar);
            document.body.appendChild(form);
            form.submit();
        }
        function copiarCodigo(button) {
            const container = button.closest('.code-block-container');
            const codeElement = container.querySelector('code');
            const codeToCopy = codeElement.innerText;

            navigator.clipboard.writeText(codeToCopy).then(() => {
                button.innerHTML = '<i class="fas fa-check"></i> Copiado!';
                setTimeout(() => {
                    button.innerHTML = '<i class="far fa-copy"></i> Copiar';
                }, 2000);
            }).catch(err => {
                console.error('Error al copiar el código: ', err);
                button.innerText = 'Error';
            });
        }
    </script>


</body>
</html>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnEditar = document.querySelector(".btn-editar-perfil");
        const vista = document.getElementById("perfil-view");
        const edicion = document.getElementById("perfil-edit");

        btnEditar.addEventListener("click", function (e) {
            e.preventDefault(); // para que no te mande a otra URL
            vista.style.display = "none";
            edicion.style.display = "block";
        });
    });

    function cancelarEdicion() {
        document.getElementById("perfil-view").style.display = "block";
        document.getElementById("perfil-edit").style.display = "none";
    }
</script>