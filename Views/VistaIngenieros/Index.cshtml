@model IngeLab.Models.IngenieroDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Mi Feed";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - IngeLab</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />

    <link rel="stylesheet" href="~/css/VistaIngenieros.css" asp-append-version="true">
</head>
<body class="body-vista-ingeniero">

    <header class="header-ingeniero">
        <div class="header-left">
            <a href="@Url.Action("Index", "IngenieroPerfil")" class="perfil-link">
                <img src="https://via.placeholder.com/50" alt="Foto de perfil" class="perfil-foto">
                <span>Mi Perfil</span>
            </a>

            <div class="notificaciones-container">
                <button class="btn-notificaciones" id="btnNotificaciones">
                    <i class="fas fa-bell"></i>
                    @if (Model != null && Model.NotificacionesNoLeidasCount > 0)
                    {
                        <span class="notificacion-badge">@Model.NotificacionesNoLeidasCount</span>
                    }
                </button>

                <div class="notificaciones-dropdown" id="notificacionesDropdown">
                    <div class="notificaciones-header">
                        <h4>Notificaciones</h4>
                        @if (Model != null && Model.NotificacionesNoLeidasCount > 0)
                        {
                            <button class="btn-marcar-leidas">
                                Marcar todas como leídas
                            </button>
                        }
                    </div>

                    <div class="notificaciones-lista">
                        @if (Model != null && Model.Notificaciones.Any())
                        {
                            @foreach (var notificacion in Model.Notificaciones)
                            {
                                <div class="notificacion-item @(notificacion.IsLeida ? "vista" : "")" data-id="@notificacion.IdContacto">
                                    <div class="notificacion-empresa"><strong>@notificacion.Empresa</strong></div>
                                    <div class="notificacion-oferta">@notificacion.Oferta</div>
                                    <div class="notificacion-fecha"><small>@notificacion.Fecha.ToString("dd/MM/yyyy HH:mm")</small></div>
                                    <div class="notificacion-acciones">
                                        <button class="btn-aceptar" data-id="@notificacion.IdContacto"><i class="fas fa-thumbs-up"></i> Aceptar</button>
                                        <button class="btn-rechazar" data-id="@notificacion.IdContacto"><i class="fas fa-thumbs-down"></i> Rechazar</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="no-notificaciones">
                                <i class="fas fa-bell-slash"></i>
                                <p>No tienes notificaciones pendientes</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="columna-central">
        <div class="crear-post-card">
            <form method="post" asp-controller="VistaIngenieros" asp-action="Post">
                @{
                    var idUsuario = Context.Session.GetInt32("UsuarioId") ?? 0;
                }
                <input type="hidden" name="Id_Usuario" value="@idUsuario" />
                @Html.AntiForgeryToken()

                <textarea class="input-post" name="Contenido" placeholder="¿En qué proyecto estás trabajando, @Model.PerfilActual.Nombre?"></textarea>
                <div class="post-acciones">
                    <button type="button" class="btn-accion-post" id="btn-abrir-modal-codigo"><i class="fas fa-code"></i> Fragmento de código</button>
                    <button type="submit" class="btn-publicar">Publicar</button>
                </div>
            </form>
        </div>

        @foreach (var post in Model.PostsPublicados)
        {
            <div class="post-card" data-post-id="@post.Id_Post">
                <div class="post-header">
                    <img src="https://via.placeholder.com/45" alt="autor" class="post-autor-foto">
                    <div class="post-autor-info">
                        <h4>@post.AutorNombre @post.AutorApellido</h4>
                        <p>@post.FechaCreacion.ToString("dd MMM, HH:mm")</p>
                    </div>
                    @if (post.Id_Usuario == Model.PerfilActual.Id_Usuario)
                    {
                        <div class="post-opciones">
                            <button type="button" class="btn-opciones"><i class="fas fa-ellipsis-h"></i></button>
                            <div class="opciones-menu">
                                <a href="#" class="btn-editar-post">Editar</a>
                                <a href="#" class="btn-fijar-post" data-fijar="@(post.Fijado ? "false" : "true")">
                                    @(post.Fijado ? "Desfijar" : "Fijar")
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="post-contenido">
                    @if (post.Tipo_Contenido == "texto")
                    {
                        <p>@post.Contenido</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(post.TextoExplicativo))
                        {
                            <p>@post.TextoExplicativo</p>
                        }
                        <div class="code-block-container">
                            <div class="code-block-header">
                                <span class="language-tag">@post.Tipo_Contenido</span>
                                <button type="button" class="copy-code-btn"><i class="far fa-copy"></i> Copiar</button>
                            </div>
                            <pre><code class="language-@post.Tipo_Contenido">@post.Codigo</code></pre>
                        </div>
                    }
                </div>

                <div class="form-editar-container" style="display:none;">
                    <form method="post" asp-controller="VistaIngenieros" asp-action="EditarPost">
                        <input type="hidden" name="idPost" value="@post.Id_Post" />
                        <textarea name="contenido" class="form-control">@post.Contenido</textarea>
                        <div class="mt-2" style="display: flex; justify-content: flex-end; gap: 10px;">
                            <button type="submit" class="btn btn-success btn-sm">Guardar</button>
                            <button type="button" class="btn btn-cancelar-edicion btn-secondary btn-sm">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </main>

    <div id="modal-codigo" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <form asp-controller="VistaIngenieros" asp-action="PublicarCodigo" method="post">
                <h3>Compartir Fragmento de Código</h3>
                <div class="form-group">
                    <label for="TextoExplicativo">Descripción (opcional):</label>
                    <textarea name="TextoExplicativo" class="modal-textarea" rows="3" placeholder="Añade un contexto para tu código..."></textarea>
                </div>
                <div class="form-group">
                    <label for="Tipo_Contenido">Lenguaje:</label>
                    <select name="Tipo_Contenido" class="modal-select">
                        <option value="csharp">C#</option>
                        <option value="java">Java</option>
                        <option value="javascript">JavaScript</option>
                        <option value="python">Python</option>
                        <option value="sql">SQL</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="Codigo">Código:</label>
                    <textarea name="Codigo" class="modal-textarea" rows="10" placeholder="Pega tu código aquí..."></textarea>
                </div>
                <div class="modal-acciones">
                    <button type="button" id="btn-cancelar-codigo" class="btn-modal-cancelar">Cancelar</button>
                    <button type="submit" class="btn-modal-publicar">Publicar</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            Prism.highlightAll();

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // --- LÓGICA GENERAL DE LA UI ---

            // Cerrar menús o dropdowns si se hace clic fuera de ellos
            document.addEventListener('click', (e) => {
                // Cierra dropdown de notificaciones
                const notificacionesContainer = e.target.closest('.notificaciones-container');
                if (!notificacionesContainer) {
                    document.getElementById('notificacionesDropdown').classList.remove('active');
                }

                // Cierra menú de opciones de posts
                document.querySelectorAll('.opciones-menu').forEach(menu => {
                    if (!menu.parentElement.contains(e.target)) {
                        menu.style.display = 'none';
                    }
                });
            });

            // --- LÓGICA DE NOTIFICACIONES ---

            const notificacionesContainer = document.querySelector('.notificaciones-container');
            if (notificacionesContainer) {
                // Abrir/Cerrar dropdown de notificaciones
                document.getElementById('btnNotificaciones').addEventListener('click', (e) => {
                    e.stopPropagation();
                    document.getElementById('notificacionesDropdown').classList.toggle('active');
                });

                // Manejar clics dentro del dropdown de notificaciones
                document.getElementById('notificacionesDropdown').addEventListener('click', (e) => {
                    e.stopPropagation(); // Evita que se cierre al hacer clic dentro

                    const target = e.target.closest('button');
                    if (!target) return;

                    const idNotificacion = target.dataset.id;

                    if (target.matches('.btn-aceptar')) {
                        gestionarOferta(idNotificacion, '@Url.Action("AceptarOferta", "VistaIngenieros")');
                    } else if (target.matches('.btn-rechazar')) {
                        gestionarOferta(idNotificacion, '@Url.Action("RechazarOferta", "VistaIngenieros")');
                    } else if (target.matches('.btn-marcar-leidas')) {
                        marcarTodasComoLeidas();
                    }
                });
            }

            function marcarTodasComoLeidas() {
                fetch('@Url.Action("MarcarTodasComoLeidas", "Notificaciones")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const badge = document.querySelector('.notificacion-badge');
                        const btnMarcar = document.querySelector('.btn-marcar-leidas');
                        if (badge) {
                            badge.style.transition = 'opacity 0.5s ease';
                            badge.style.opacity = '0';
                            setTimeout(() => badge.style.display = 'none', 500);
                        }
                        if (btnMarcar) btnMarcar.style.display = 'none';

                        document.querySelectorAll('.notificacion-item:not(.vista)').forEach(item => {
                            item.classList.add('vista');
                        });
                    }
                }).catch(err => console.error('Error:', err));
            }

            function gestionarOferta(id, url) {
                const formData = new URLSearchParams();
                formData.append("idNotificacion", id);

                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: formData.toString()
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const item = document.querySelector(`.notificacion-item[data-id='${id}']`);
                        if(item) item.remove();
                        actualizarContadorNotificaciones();
                    } else {
                        alert(data.message || 'Error al procesar la oferta.');
                    }
                }).catch(err => console.error('Error:', err));
            }

            function actualizarContadorNotificaciones() {
                const restantes = document.querySelectorAll('.notificacion-item').length;
                if (restantes === 0) {
                    document.querySelector('.notificaciones-lista').innerHTML = `
                        <div class="no-notificaciones">
                            <i class="fas fa-bell-slash"></i>
                            <p>No tienes notificaciones pendientes</p>
                        </div>`;
                }
            }


            // --- LÓGICA DEL FEED Y POSTS ---

            const mainFeed = document.querySelector('.columna-central');
            if (mainFeed) {
                mainFeed.addEventListener('click', (e) => {
                    const postCard = e.target.closest('.post-card');
                    if (!postCard) return;

                    const idPost = postCard.dataset.postId;

                    // Menú de opciones del post (fijar, editar)
                    if (e.target.matches('.btn-opciones, .btn-opciones *')) {
                        const menu = postCard.querySelector('.opciones-menu');
                        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
                    }
                    else if (e.target.matches('.btn-fijar-post')) {
                        e.preventDefault();
                        const fijar = e.target.dataset.fijar === 'true';
                        fijarPost(idPost, fijar);
                    }
                    else if (e.target.matches('.btn-editar-post')) {
                        e.preventDefault();
                        postCard.querySelector('.post-contenido').style.display = 'none';
                        postCard.querySelector('.form-editar-container').style.display = 'block';
                    }
                    else if (e.target.matches('.btn-cancelar-edicion')) {
                        postCard.querySelector('.form-editar-container').style.display = 'none';
                        postCard.querySelector('.post-contenido').style.display = 'block';
                    }
                    else if (e.target.matches('.copy-code-btn, .copy-code-btn *')) {
                        copiarCodigo(e.target.closest('.copy-code-btn'));
                    }
                });
            }

            function fijarPost(id, fijar) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("FijarPost", "VistaIngenieros")';
                form.innerHTML = `
                    <input type="hidden" name="idPost" value="${id}" />
                    <input type="hidden" name="fijar" value="${fijar}" />
                `;
                document.body.appendChild(form);
                form.submit();
            }

            function copiarCodigo(button) {
                const code = button.closest('.code-block-container').querySelector('code').innerText;
                navigator.clipboard.writeText(code).then(() => {
                    button.innerHTML = '<i class="fas fa-check"></i> Copiado';
                    setTimeout(() => {
                        button.innerHTML = '<i class="far fa-copy"></i> Copiar';
                    }, 2000);
                });
            }

            // --- LÓGICA DEL MODAL DE CÓDIGO ---

            const modalCodigo = document.getElementById('modal-codigo');
            if(modalCodigo) {
                document.getElementById('btn-abrir-modal-codigo').addEventListener('click', () => {
                    modalCodigo.style.display = 'flex';
                });

                document.getElementById('btn-cancelar-codigo').addEventListener('click', () => {
                    modalCodigo.style.display = 'none';
                });

                modalCodigo.addEventListener('click', (e) => {
                    if (e.target === modalCodigo) { // Cierra si se hace clic en el fondo
                        modalCodigo.style.display = 'none';
                    }
                });
            }
        });
    </script>

</body>
</html>