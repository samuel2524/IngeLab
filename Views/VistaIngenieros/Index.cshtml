@model IngeLab.Models.IngenieroDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Mi Feed";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - IngeLab</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet" href="~/css/VistaIngenieros.css" asp-append-version="true">

</head>
<body class="body-vista-ingeniero">

    <header class="header-ingeniero">
        <div class="header-left">
            <a href="@Url.Action("Index", "IngenieroPerfil")" class="perfil-link">
                <img src="https://via.placeholder.com/50" alt="Foto de perfil" class="perfil-foto">
                <span>Mi Perfil</span>
            </a>

            <div class="notificaciones-container">
                <button class="btn-notificaciones" id="btnNotificaciones">
                    <i class="fas fa-bell"></i>
                    @if (Model != null && Model.NotificacionesNoLeidasCount > 0)
                    {
                        <span class="notificacion-badge">@Model.NotificacionesNoLeidasCount</span>
                    }
                </button>

                <div class="notificaciones-dropdown" id="notificacionesDropdown">
                    <div class="notificaciones-header">
                        <h4>Notificaciones</h4>
                        @if (Model != null && Model.NotificacionesNoLeidasCount > 0)
                        {
                            <button class="btn-marcar-leidas">Marcar todas como leídas</button>
                        }
                    </div>

                    <div class="notificaciones-lista">
                        @if (Model != null && Model.Notificaciones.Any())
                        {
                            @foreach (var notificacion in Model.Notificaciones)
                            {
                                <div class="notificacion-item @(notificacion.IsLeida ? "vista" : "")" data-id="@notificacion.IdContacto">
                                    <div class="notificacion-empresa"><strong>@notificacion.Empresa</strong></div>
                                    <div class="notificacion-oferta">@notificacion.Oferta</div>
                                    <div class="notificacion-fecha"><small>@notificacion.Fecha.ToString("dd/MM/yyyy HH:mm")</small></div>
                                    <div class="notificacion-acciones">
                                        <button class="btn-aceptar" data-id="@notificacion.IdContacto"><i class="fas fa-thumbs-up"></i> Aceptar</button>
                                        <button class="btn-rechazar" data-id="@notificacion.IdContacto"><i class="fas fa-thumbs-down"></i> Rechazar</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="no-notificaciones">
                                <i class="fas fa-bell-slash"></i>
                                <p>No tienes notificaciones pendientes</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="columna-central">
        <div class="crear-post-card">
            <form method="post" asp-controller="VistaIngenieros" asp-action="Post">
                @{
                    var idUsuario = Context.Session.GetInt32("UsuarioId") ?? 0;
                }
                <input type="hidden" name="Id_Usuario" value="@idUsuario" />
                @Html.AntiForgeryToken()

                <textarea class="input-post" name="Contenido" placeholder="¿Tienes una idea? Inicia un nuevo hilo..."></textarea>
                <div class="post-acciones">
                    <button type="button" class="btn-accion-post" id="btn-abrir-modal-codigo"><i class="fas fa-code"></i> Iniciar con Código</button>
                    <button type="submit" class="btn-publicar">Publicar Hilo</button>
                </div>
            </form>
        </div>

        @foreach (var post in Model.PostsPublicados)
        {
            <div class="post-card" data-post-id="@post.Id_Post">
                <div class="post-header">
                    <img src="https://via.placeholder.com/45" alt="autor" class="post-autor-foto">
                    <div class="post-autor-info">
                        <h4>@post.AutorNombre @post.AutorApellido</h4>
                        <p>@post.FechaCreacion.ToString("dd MMM, HH:mm")</p>
                    </div>
                    @if (post.Id_Usuario == Model.PerfilActual.Id_Usuario)
                    {
                        <div class="post-opciones">
                            <button type="button" class="btn-opciones"><i class="fas fa-ellipsis-h"></i></button>
                            <div class="opciones-menu">
                                <a href="#" class="btn-editar-post">Editar</a>
                                <a href="#" class="btn-fijar-post" data-fijar="@(post.Fijado ? "false" : "true")">
                                    @(post.Fijado ? "Desfijar" : "Fijar")
                                </a>
                                <a href="#" class="btn-eliminar-post opcion-eliminar">Eliminar</a>
                            </div>
                        </div>
                    }
                </div>

                <div class="post-contenido">
                    @if (post.Tipo_Contenido == "texto")
                    {
                        <p>@post.Contenido</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(post.TextoExplicativo))
                        {
                            <p>@post.TextoExplicativo</p>
                        }
                        <div class="code-block-container">
                            <div class="code-block-header">
                                <span class="language-tag">@post.Tipo_Contenido</span>
                                <button type="button" class="copy-code-btn"><i class="far fa-copy"></i> Copiar</button>
                            </div>
                            <pre><code class="language-@post.Tipo_Contenido">@post.Codigo</code></pre>
                        </div>
                    }
                </div>

                <div class="form-editar-container" style="display:none;">
                    <form method="post" asp-controller="VistaIngenieros" asp-action="EditarPost">
                        <input type="hidden" name="idPost" value="@post.Id_Post" />
                        <textarea name="contenido" class="form-control">@post.Contenido</textarea>
                        <div class="mt-2" style="display: flex; justify-content: flex-end; gap: 10px;">
                            <button type="submit" class="btn btn-success btn-sm">Guardar</button>
                            <button type="button" class="btn-cancelar-edicion btn-secondary btn-sm">Cancelar</button>
                        </div>
                    </form>
                </div>

                <div class="post-footer">
                    <a href="@Url.Action("Detalle", "Hilo", new { id = post.Id_Post })" class="respuesta-contador-link">
                        <div class="respuesta-contador">
                            @if (post.CantidadRespuestas > 0)
                            {
                                <i class="fas fa-comments"></i>
                                <span>@post.CantidadRespuestas @(post.CantidadRespuestas == 1 ? "respuesta" : "respuestas")</span>
                            }
                            else
                            {
                                <i class="far fa-comments"></i>
                                <span>Ver hilo</span>
                            }
                        </div>
                    </a>
                    <div class="footer-acciones">
                        <button type="button" class="btn-respuesta" data-post-id="@post.Id_Post">
                            <i class="fas fa-reply"></i> Responder
                        </button>
                        <button type="button" class="btn-respuesta-codigo" data-post-id="@post.Id_Post" title="Responder con Código">
                            <i class="fas fa-code"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <div id="modal-codigo" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <form asp-controller="VistaIngenieros" asp-action="PublicarCodigo" method="post">
                <h3>Compartir Fragmento de Código</h3>
                <div class="form-group">
                    <label>Descripción (opcional):</label>
                    <textarea name="TextoExplicativo" class="modal-textarea" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label>Lenguaje:</label>
                    <select name="Tipo_Contenido" class="modal-select">
                        <option value="csharp">C#</option>
                        <option value="java">Java</option>
                        <option value="javascript">JavaScript</option>
                        <option value="python">Python</option>
                        <option value="sql">SQL</option>
                        <option value="html">HTML</option>
                        <option value="css">CSS</option>
                        <option value="bash">Bash/Shell</option>
                        <option value="json">JSON</option>
                        <option value="swift">Swift</option>
                        <option value="r">R</option>
                        <option value="r">php</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Código:</label>
                    <textarea name="Codigo" class="modal-textarea" rows="10"></textarea>
                </div>
                <div class="modal-acciones">
                    <button type="button" class="btn-modal-cancelar">Cancelar</button>
                    <button type="submit" class="btn-modal-publicar">Publicar</button>
                </div>
            </form>
        </div>
    </div>

    <div id="modal-respuesta" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <form id="form-respuesta" method="post" asp-controller="VistaIngenieros" asp-action="PublicarRespuesta">
                @Html.AntiForgeryToken()
                <h3>Añadir una respuesta</h3>
                <input type="hidden" id="idPostPadreTexto" name="IdPostPadre" />
                <div class="form-group">
                    <textarea name="Contenido" class="modal-textarea" rows="5" placeholder="Escribe tu respuesta..."></textarea>
                </div>
                <input type="hidden" name="Tipo_Contenido" value="texto" />
                <div class="modal-acciones">
                    <button type="button" class="btn-modal-cancelar">Cancelar</button>
                    <button type="submit" class="btn-modal-publicar">Publicar Respuesta</button>
                </div>
            </form>
        </div>
    </div>

    <div id="modal-respuesta-codigo" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <form method="post" asp-controller="VistaIngenieros" asp-action="PublicarRespuesta">
                @Html.AntiForgeryToken()
                <h3>Responder con Código</h3>
                <input type="hidden" id="idPostPadreCodigo" name="IdPostPadre" />
                <div class="form-group">
                    <label>Descripción (opcional):</label>
                    <textarea name="TextoExplicativo" class="modal-textarea" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label>Lenguaje:</label>
                    <select name="Tipo_Contenido" class="modal-select">
                        <option value="csharp">C#</option>
                        <option value="java">Java</option>
                        <option value="javascript">JavaScript</option>
                        <option value="python">Python</option>
                        <option value="sql">SQL</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Código:</label>
                    <textarea name="Codigo" class="modal-textarea" rows="10"></textarea>
                </div>
                <div class="modal-acciones">
                    <button type="button" class="btn-modal-cancelar">Cancelar</button>
                    <button type="submit" class="btn-modal-publicar">Publicar Respuesta</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            Prism.highlightAll();

            const tokenInput = document.querySelector('form[method="post"] input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const modalRespuesta = document.getElementById('modal-respuesta');
            const modalCodigo = document.getElementById('modal-codigo');
            const modalRespuestaCodigo = document.getElementById('modal-respuesta-codigo');

            // --- Lógica Genérica para Cerrar Modales ---
            document.querySelectorAll('.modal-overlay').forEach(modal => {
                const btnCancelar = modal.querySelector('.btn-modal-cancelar');
                if (btnCancelar) {
                    btnCancelar.addEventListener('click', () => { modal.style.display = 'none'; });
                }
                modal.addEventListener('click', e => {
                    if (e.target === modal) { modal.style.display = 'none'; }
                });
            });

            // --- Lógica de Eventos Centralizada (Delegación) ---
            document.body.addEventListener('click', (e) => {
                const target = e.target;
                const button = target.closest('button');
                const link = target.closest('a');
                const postCard = target.closest('.post-card');

                // --- ACCIONES CON BOTONES ---
                if (button) {
                    // Acciones de Hilos
                    if (button.matches('.btn-respuesta')) {
                        modalRespuesta.querySelector('#idPostPadreTexto').value = button.dataset.postId;
                        modalRespuesta.style.display = 'flex';
                    }
                    else if (button.matches('.btn-respuesta-codigo')) {
                        modalRespuestaCodigo.querySelector('#idPostPadreCodigo').value = button.dataset.postId;
                        modalRespuestaCodigo.style.display = 'flex';
                    }
                    // Acciones de Crear Post
                    else if (button.matches('#btn-abrir-modal-codigo')) {
                        modalCodigo.style.display = 'flex';
                    }
                    // Acciones dentro de una tarjeta
                    else if (postCard) {
                        if (button.matches('.btn-opciones, .btn-opciones *')) {
                            const menu = button.nextElementSibling;
                            if(menu) menu.style.display = 'block';
                        }
                        else if (button.matches('.btn-cancelar-edicion')) {
                            postCard.querySelector('.form-editar-container').style.display = 'none';
                            postCard.querySelector('.post-contenido').style.display = 'block';
                        }
                        else if (button.matches('.copy-code-btn')) {
                            copiarCodigo(button);
                        }
                    }
                }

                // --- ACCIONES CON LINKS (EN EL MENÚ DE OPCIONES) ---
                if (link && postCard) {
                    const idPost = postCard.dataset.postId;
                    if (link.matches('.btn-editar-post')) {
                        e.preventDefault();
                        postCard.querySelector('.post-contenido').style.display = 'none';
                        postCard.querySelector('.form-editar-container').style.display = 'block';
                        link.closest('.opciones-menu').style.display = 'none';
                    }
                    else if (link.matches('.btn-fijar-post')) {
                        e.preventDefault();
                        fijarPost(idPost, link.dataset.fijar === 'true');
                    }
                    else if (link.matches('.btn-eliminar-post')) {
                        e.preventDefault();
                        if (confirm('¿Estás seguro de que quieres eliminar este post? Esta acción no se puede deshacer.')) {
                            eliminarPost(idPost);
                        }
                    }
                }
            });

            // Cierre de Menús de Opciones al hacer clic fuera
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.post-opciones')) {
                    document.querySelectorAll('.opciones-menu').forEach(menu => {
                        menu.style.display = 'none';
                    });
                }
            });

            // --- LÓGICA DE NOTIFICACIONES ---
            const notificacionesContainer = document.querySelector('.notificaciones-container');
            if (notificacionesContainer) {
                document.getElementById('btnNotificaciones').addEventListener('click', e => {
                    e.stopPropagation();
                    document.getElementById('notificacionesDropdown').classList.toggle('active');
                });
                document.getElementById('notificacionesDropdown').addEventListener('click', e => {
                    e.stopPropagation();
                    const target = e.target.closest('button');
                    if (!target) return;
                    if (target.matches('.btn-aceptar') || target.matches('.btn-rechazar')) {
                        const url = target.matches('.btn-aceptar')
                            ? '@Url.Action("AceptarOferta", "VistaIngenieros")'
                            : '@Url.Action("RechazarOferta", "VistaIngenieros")';
                        gestionarOferta(target.dataset.id, url);
                    } else if (target.matches('.btn-marcar-leidas')) {
                        marcarTodasComoLeidas();
                    }
                });
            }

            // --- FUNCIONES AUXILIARES ---
            function gestionarOferta(id, url) {
                const formData = new URLSearchParams();
                formData.append("idNotificacion", id);
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: formData.toString()
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.querySelector(`.notificacion-item[data-id='${id}']`)?.remove();
                    } else { alert(data.message || 'Error al procesar la oferta.'); }
                }).catch(err => console.error('Error:', err));
            }

                    function marcarTodasComoLeidas() {
            fetch('@Url.Action("MarcarTodasComoLeidas", "VistaIngenieros")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // ✅ Marcar visualmente todas las notificaciones como leídas
                    document.querySelectorAll('.notificacion-item').forEach(el => {
                        el.classList.add('vista');
                    });

                    // ✅ Actualizar el contador de la burbuja
                    const badge = document.querySelector('.notificacion-badge');
                    if (badge) badge.remove();

                    // ✅ Pequeño feedback visual
                    const header = document.querySelector('.notificaciones-header h4');
                    if (header) {
                        header.textContent = "Notificaciones (todas leídas)";
                        header.style.opacity = 0.7;
                    }
                } else {
                    console.error('Error:', data.message);
                }
            })
            .catch(err => console.error('Error:', err));
        }


             function fijarPost(id, fijar) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("FijarPost", "VistaIngenieros")';
                form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}" /><input type="hidden" name="idPost" value="${id}" /><input type="hidden" name="fijar" value="${fijar}" />`;
                document.body.appendChild(form);
                form.submit();
            }

            function eliminarPost(id) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("EliminarPost", "VistaIngenieros")';
                form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}" /><input type="hidden" name="idPost" value="${id}" />`;
                document.body.appendChild(form);
                form.submit();
            }

            function copiarCodigo(button) {
                const code = button.closest('.code-block-container').querySelector('code').innerText;
                navigator.clipboard.writeText(code).then(() => {
                    button.innerHTML = '<i class="fas fa-check"></i> Copiado';
                    setTimeout(() => { button.innerHTML = '<i class="far fa-copy"></i> Copiar'; }, 2000);
                });
            }
        });
    </script>
</body>
</html>